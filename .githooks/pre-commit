#!/bin/sh
# --- vexp start ---
# Generated by vexp — finalize index before commit
VEXP_CORE=""
if command -v vexp-core > /dev/null 2>&1; then
    VEXP_CORE="vexp-core"
elif [ -f "$(git rev-parse --git-dir)/../node_modules/.bin/vexp-core" ]; then
    VEXP_CORE="$(git rev-parse --git-dir)/../node_modules/.bin/vexp-core"
fi
if [ -n "$VEXP_CORE" ]; then
    "$VEXP_CORE" index --finalize > /dev/null 2>&1 || true
    git add .vexp/manifest.json 2>/dev/null || true
fi
# --- vexp end ---

# Generate OG image to keep it up to date in repository if UI files changed
if [ -f "website/scripts/generate-og-image.js" ]; then
    if git diff --cached --name-only | grep -E '^website/(src/|package\.json|vite\.config\.js|vite\.config\.ts|tailwind\.config\.js)' > /dev/null 2>&1; then
        echo "📸 UI changes detected. Generating social media OG image..."
        if command -v pnpm > /dev/null 2>&1; then
            pnpm --filter website run build:og && git add website/static/og-image.png || echo "⚠️  Warning: Failed to generate or stage social media OG image. Proceeding with commit."
        else
            echo "⚠️  Warning: 'pnpm' command not found in PATH. Skipping automatic OG image generation."
        fi
    fi
fi
